# Copy to .env and fill in. docker compose auto-loads .env from this directory.

# --- Required secrets ---
# Generate strong random values, e.g.:  openssl rand -base64 48
JWT_SECRET=change-me-generate-a-long-random-value
POW_SECRET=change-me-generate-another-random-value

# --- Database (defaults match docker-compose) ---
POSTGRES_USER=kahoot
POSTGRES_PASSWORD=kahoot
POSTGRES_DB=kahoot

# --- Optional ---
# Public base URL, used to build password-reset links (else a relative path is logged).
APP_BASE_URL=
# Max DB connections in the pool (default 5).
DB_MAX_CONNECTIONS=5
# Port the server listens on (default 3000).
PORT=3000
